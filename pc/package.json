    "@rollup/plugin-node-resolve": "^9.0.0",
    "@vitejs/plugin-vue": "^1.2.3",
    "@vue/compiler-sfc": "^3.0.5",
    "chalk": "^4.1.0",
    "concurrently": "^5.3.0",
    "dotenv": "^8.2.0",
    "electron": "^13.1.2",
    "electron-builder": "^22.11.7",
    "electron-connect": "^0.6.3",
    "electron-is-dev": "^1.2.0",
    "electron-store": "^6.0.0",
    "minimist": "^1.2.5",
    "ora": "^5.0.0",
    "rollup-plugin-esbuild": "^4.5.0",
    "typescript": "^4.3.2",
    "vite": "^2.3.7",
